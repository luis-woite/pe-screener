# Copy this file to ".env" and fill in your real keys.
# Never commit the real ".env" file — add it to .gitignore.

# Required from Phase 3 onward (LLM synthesis).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# Optional — only needed if you use NewsAPI.org instead of GDELT for news ingestion (Phase 1).
# Free tier key at https://newsapi.org/register
NEWSAPI_KEY=your_key_here

# Required for Phase 1 SEC EDGAR filing lookups. SEC requires every request
# to identify a real contact — this is sent as part of the User-Agent header,
# never logged or transmitted anywhere else.
SEC_CONTACT_EMAIL=your_email@example.com
